{
  "name": "kawaz-mcp-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "start": "node --env-file .env dist/index.js",
    "start:dev": "npm run build && npm run start",
    "dev": "ts-node-dev --respawn --env-file .env src/index.ts",
    "clean": "rimraf dist",
    "clean:advanced": "rimraf dist && rimraf node_modules && rimraf package-lock.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@ido_kawaz/server-framework": "^3.6.0",
    "ramda": "^0.32.0",
    "zod": "^4.3.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/ramda": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "express": "^4.18.2",
    "rimraf": "^5.0.0",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8"
  }
}